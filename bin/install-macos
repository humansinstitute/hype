#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
DESTINATION="${HYPE_APP_DESTINATION:-$HOME/Applications/Hype.app}"

if [ "$(uname -s)" != Darwin ]; then
    printf '%s\n' 'bin/install-macos is only for macOS.' >&2
    exit 1
fi

"$ROOT/bin/build"

mkdir -p "$(dirname "$DESTINATION")"
rm -rf "$DESTINATION"
ditto "$ROOT/build/hype.app" "$DESTINATION"

# Deploy only the install copy. macdeployqt rewrites Mach-O load commands, so
# mutating build/hype.app would break CLI tests that copy its executable alone.
MACDEPLOYQT="${MACDEPLOYQT:-/opt/homebrew/opt/qt/bin/macdeployqt}"
if [ ! -x "$MACDEPLOYQT" ]; then
    printf '%s\n' 'macdeployqt was not found. Install Qt 6 with Homebrew.' >&2
    exit 1
fi
printf '%s\n' 'Bundling Qt frameworks and plugins (this can take several minutes)...'
# Qt 6.11's macdeployqt scans optional Homebrew QML/plugin families (notably
# VirtualKeyboard and Hunspell) and prints unresolved-rpath diagnostics for
# modules Hype never imports. The finished bundle is audited and signed below;
# suppress that misleading scanner noise while retaining deployment failures.
DEPLOY_LOG="$(mktemp -t hype-macdeployqt.XXXXXX)"
if ! "$MACDEPLOYQT" "$DESTINATION" -qmldir="$ROOT/src" -always-overwrite -verbose=0 >"$DEPLOY_LOG" 2>&1; then
    cat "$DEPLOY_LOG" >&2
    rm -f "$DEPLOY_LOG"
    exit 1
fi
rm -f "$DEPLOY_LOG"

# qmake's linker-generated ad-hoc signature does not seal the completed app
# bundle. Re-sign the installed copy after every file is in place so dyld does
# not terminate it with CODESIGNING/Invalid Page on launch.
SIGNING_IDENTITY="${HYPE_SIGNING_IDENTITY:--}"
if [ "$SIGNING_IDENTITY" = - ]; then
    codesign --force --deep --sign - --timestamp=none "$DESTINATION"
else
    codesign --force --deep --options runtime --timestamp --sign "$SIGNING_IDENTITY" "$DESTINATION"
fi
codesign --verify --deep --strict "$DESTINATION"
printf '%s\n' 'Verified Hype application signature.'

printf 'Installed Hype at %s\n' "$DESTINATION"
printf 'Launch it with: open %s\n' "$(printf '%s' "$DESTINATION" | sed "s/'/'\\\\''/g; s/^/'/; s/$/'/")"
